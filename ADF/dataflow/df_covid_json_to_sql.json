{
	"name": "df_covid_json_to_sql",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_REST_disease_api",
						"type": "DatasetReference"
					},
					"name": "RESTdataset"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_sql_disease_table",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "select1"
				},
				{
					"name": "derivedColumnExtractBodyContent"
				}
			],
			"scriptLines": [
				"source(output(",
				"          body as (active as integer, activePerOneMillion as double, cases as integer, casesPerOneMillion as short, continent as string, country as string, countryInfo as ({_id} as short, flag as string, iso2 as string, iso3 as string, lat as short, long as short), critical as boolean, criticalPerOneMillion as boolean, deaths as integer, deathsPerOneMillion as short, oneCasePerPeople as short, oneDeathPerPeople as short, oneTestPerPeople as short, population as integer, recovered as boolean, recoveredPerOneMillion as boolean, tests as integer, testsPerOneMillion as integer, todayCases as boolean, todayDeaths as boolean, todayRecovered as boolean, updated as long),",
				"          headers as [string,string]",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     limit: 10,",
				"     httpMethod: 'GET',",
				"     timeout: 30,",
				"     paginationRules: ['supportRFC5988' -> 'true'],",
				"     responseFormat: ['type' -> 'json', 'documentForm' -> 'singleDocument']) ~> RESTdataset",
				"derivedColumnExtractBodyContent select(mapColumn(",
				"          updated,",
				"          country,",
				"          cases,",
				"          todayCases,",
				"          deaths,",
				"          todayDeaths,",
				"          recovered,",
				"          active,",
				"          critical",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"RESTdataset derive(updated = toLong(body.updated),",
				"          country = body.country,",
				"          cases = toInteger(body.cases),",
				"          deaths = toInteger(body.deaths),",
				"          recovered = iif(isNull(body.recovered), 0,\r",
				"    iif(lower(trim(toString(body.recovered))) == 'true', 1,\r",
				"        iif(lower(trim(toString(body.recovered))) == 'false', 0,\r",
				"            toInteger(toString(body.recovered))\r",
				"      )\r",
				"    )\r",
				"  ),",
				"          active = toInteger(body.active),",
				"          iso2 = body.countryInfo.iso2,",
				"          iso3 = body.countryInfo.iso3,",
				"          lat = toFloat(body.countryInfo.lat),",
				"          lon = toFloat(body.countryInfo.long),",
				"          flag_url = toString(body.countryInfo.flag),",
				"          critical = iif(isNull(body.critical), 0,    iif(lower(trim(toString(body.critical))) == 'true', 1,        iif(lower(trim(toString(body.critical))) == 'false', 0,            toInteger(toString(body.critical))      )    )  ),",
				"          todayDeaths = iif(isNull(body.todayDeaths), 0,    iif(lower(trim(toString(body.todayDeaths))) == 'true', 1,        iif(lower(trim(toString(body.todayDeaths))) == 'false', 0,            toInteger(toString(body.todayDeaths))      )    )  ),",
				"          todayCases = iif(isNull(body.todayCases), 0,    iif(lower(trim(toString(body.todayCases))) == 'true', 1,        iif(lower(trim(toString(body.todayCases))) == 'false', 0,            toInteger(toString(body.todayCases))      )    )  )) ~> derivedColumnExtractBodyContent",
				"select1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          updated as long,",
				"          country as string,",
				"          cases as integer,",
				"          todayCases as integer,",
				"          deaths as integer,",
				"          todayDeaths as integer,",
				"          recovered as integer,",
				"          active as integer,",
				"          critical as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}